<Window x:Class="LibmpvIptvClient.ScheduledRecordingListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ScheduledRecordingList_Title}" Width="900" Height="500" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
  <DockPanel Margin="12">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock x:Name="TxtFrontCount" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
      <TextBlock x:Name="TxtBackCount" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
      <ComboBox x:Name="CmbStatusFilter" Width="100" Margin="0,0,8,0" SelectionChanged="CmbStatusFilter_SelectionChanged">
        <ComboBoxItem Content="全部" Tag="" IsSelected="True"/>
        <ComboBoxItem Content="录制中" Tag="Recording"/>
        <ComboBoxItem Content="等待中" Tag="Waiting"/>
        <ComboBoxItem Content="已停止" Tag="Stopped"/>
        <ComboBoxItem Content="已完成" Tag="Completed"/>
        <ComboBoxItem Content="已取消" Tag="Cancelled"/>
        <ComboBoxItem Content="失败" Tag="Failed"/>
      </ComboBox>
      <Button Content="{DynamicResource ScheduledRecordingList_Refresh}" Width="80" Margin="0,0,8,0" Click="BtnRefresh_Click" Style="{StaticResource ChipButton}"/>
      <Button Content="{DynamicResource ScheduledRecordingList_Stop}" Width="64" Margin="8,0,4,0" Click="BtnStop_Click" Style="{StaticResource ChipButton}"/>
      <Button Content="{DynamicResource Recording_Cancel}" Width="64" Margin="4,0,8,0" Click="BtnCancel_Click" Style="{StaticResource ChipButton}"/>
      <Button Content="{DynamicResource UI_Delete}" Width="64" Margin="4,0,8,0" Click="BtnDelete_Click" Style="{StaticResource ChipButton}"/>
      <Button Content="{DynamicResource Recording_OpenFile}" Width="80" Margin="8,0,4,0" Click="BtnOpenFile_Click" Style="{StaticResource ChipButton}"/>
      <Button Content="{DynamicResource Recording_OpenFolder}" Width="90" Margin="4,0,0,0" Click="BtnOpenFolder_Click" Style="{StaticResource ChipButton}"/>
    </StackPanel>
    <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
              Background="{DynamicResource CardBackgroundBrush}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              GridLinesVisibility="Horizontal"
              SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{DynamicResource ScheduledRecordingList_Column_Channel}" Binding="{Binding ChannelName}" Width="120"/>
        <DataGridTextColumn Header="{DynamicResource ScheduledRecordingList_Column_Program}" Binding="{Binding ProgramTitle}" Width="*"/>
        <DataGridTextColumn Header="{DynamicResource ScheduledRecordingList_Column_Type}" Binding="{Binding TypeLabel}" Width="70"/>
        <DataGridTextColumn Header="{DynamicResource ScheduledRecordingList_Column_Start}" Width="140">
          <DataGridTextColumn.Binding>
            <Binding Path="ScheduledStart" StringFormat="yyyy-MM-dd HH:mm"/>
          </DataGridTextColumn.Binding>
        </DataGridTextColumn>
        <DataGridTextColumn Header="{DynamicResource ScheduledRecordingList_Column_End}" Width="140">
          <DataGridTextColumn.Binding>
            <Binding Path="ScheduledEnd" StringFormat="yyyy-MM-dd HH:mm"/>
          </DataGridTextColumn.Binding>
        </DataGridTextColumn>
        <DataGridTextColumn Header="{DynamicResource ScheduledRecordingList_Column_Duration}" Binding="{Binding DurationLabel}" Width="80"/>
        <DataGridTextColumn Header="{DynamicResource ScheduledRecordingList_Column_Status}" Binding="{Binding StatusLabel}" Width="80"/>
        <DataGridTextColumn Header="{DynamicResource ScheduledRecordingList_Column_Size}" Binding="{Binding SizeLabel}" Width="100"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
