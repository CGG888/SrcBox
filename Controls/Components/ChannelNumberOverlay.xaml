<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LibmpvIptvClient.ChannelNumberOverlay"
        Title="ChannelNumber"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        IsHitTestVisible="False"
        Focusable="False">
  <!-- Channel number badge flashed in the top-right corner of the video area when a channel is
       switched from the web remote. Sized by its content, so the badge always hugs the digits. -->
  <Border x:Name="BadgeSurface"
          MinWidth="112"
          CornerRadius="22"
          Padding="30,16"
          BorderBrush="#38FFFFFF"
          BorderThickness="1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6141720" Offset="0"/>
        <GradientStop Color="#CC0B0D13" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
    </Border.Effect>
    <TextBlock x:Name="TbNumber"
               Text="1"
               FontFamily="Segoe UI Semibold, Segoe UI, Microsoft YaHei UI"
               FontSize="54"
               FontWeight="SemiBold"
               Foreground="#FFFFFFFF"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               TextAlignment="Center">
      <TextBlock.Effect>
        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.45" Color="#7A8CFF"/>
      </TextBlock.Effect>
    </TextBlock>
  </Border>
</Window>
