<UserControl x:Class="LibmpvIptvClient.TimeshiftTimeline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LibmpvIptvClient"
             xmlns:controls="clr-namespace:LibmpvIptvClient.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="58">
  <UserControl.Resources>
    <!-- 自制控件样式：本控件同时被全屏浮层与窗口模式底栏宿主，不能依赖宿主的资源作用域 -->
    <Style x:Key="OverlayButtonBase" TargetType="{x:Type ButtonBase}">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ButtonBase}">
            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource ChipButtonHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource ChipButtonPressedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="OverlayIconButton" TargetType="Button" BasedOn="{StaticResource OverlayButtonBase}"/>

    <!-- 左右翻页按钮：与刻度行同高的小圆角方块，压在节目条两端 -->
    <Style x:Key="TimelineNavButton" TargetType="Button" BasedOn="{StaticResource OverlayButtonBase}">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!--
      节目段：宽度由宿主按时间比例（percent）算出后写在 ContentPresenter 上，高度固定 24，
      保证整条时间线不超过原进度条的高度量级。段内只显示节目名，水平垂直居中。
      状态（直播/回看/时移/预约）由绑定标志驱动，主题画刷一律 DynamicResource。
    -->
    <DataTemplate x:Key="TimelineProgrammeTemplate" DataType="{x:Type local:TimelineProgramme}">
      <Grid x:Name="BlockRoot" Height="24" Margin="0,0,1,0" Cursor="Hand" ToolTip="{Binding TooltipText}">
        <Border x:Name="BlockSurface" CornerRadius="3" BorderThickness="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushCommon}"/>
        <Border x:Name="BlockLiveTint" CornerRadius="3" Opacity="0" Background="{DynamicResource StatusLiveBrush}"/>
        <Border x:Name="BlockAccentTint" CornerRadius="3" Opacity="0" Background="{DynamicResource AccentBrush}"/>
        <!-- 可回看段底部 2px 主色条，与直播段的玫红底边区分开 -->
        <Rectangle x:Name="BlockReplayBar" Height="2" Opacity="0" VerticalAlignment="Bottom"
                   Fill="{DynamicResource AccentBrush}"/>
        <!-- 时移段左侧 3px 竖条 -->
        <Rectangle x:Name="BlockTimeshiftBar" Width="3" Opacity="0" HorizontalAlignment="Left"
                   Fill="{DynamicResource StatusTimeshiftBrush}"/>
        <Rectangle x:Name="BlockDash" RadiusX="3" RadiusY="3" StrokeThickness="1" Visibility="Collapsed"
                   Stroke="{DynamicResource TextSecondaryBrush}" StrokeDashArray="2 2"/>
        <!-- 段内只留节目名：水平 + 垂直居中，去掉起播时刻后不再需要两行网格 -->
        <TextBlock x:Name="BlockName" Text="{Binding Name}" FontSize="10" Margin="3,0,3,0"
                   VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <!-- 状态角标：右对齐 + 垂直居中，底色由下面的触发器按段状态取与左侧模式 chip 同一组主题画刷 -->
        <Border x:Name="BlockBadge" CornerRadius="2" Padding="3,0" Margin="0,0,2,0"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Background="{DynamicResource StatusTimeshiftBrush}" Visibility="Collapsed">
          <TextBlock x:Name="BlockBadgeText" Text="{Binding BadgeText}" FontSize="7.5" FontWeight="SemiBold"
                     Foreground="#FFFFFFFF"/>
        </Border>
        <!-- 当前直播段的右上角红点 -->
        <Ellipse x:Name="BlockNowDot" Width="5" Height="5" Margin="0,2,3,0" Visibility="Collapsed"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Fill="{DynamicResource StatusLiveBrush}"/>
      </Grid>
      <DataTemplate.Triggers>
        <!-- 正在直播的节目 -->
        <DataTrigger Binding="{Binding IsLive}" Value="True">
          <Setter TargetName="BlockLiveTint" Property="Opacity" Value="0.22"/>
          <Setter TargetName="BlockSurface" Property="BorderBrush" Value="{DynamicResource StatusLiveBrush}"/>
          <Setter TargetName="BlockNowDot" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <!-- 当前播放游标所在的节目：描边标出，文字保持主色以保证盖在进度填充上仍然可读 -->
        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
          <Setter TargetName="BlockSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
          <Setter TargetName="BlockSurface" Property="BorderThickness" Value="1.5"/>
          <Setter TargetName="BlockAccentTint" Property="Opacity" Value="0.16"/>
          <Setter TargetName="BlockName" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
          <Setter TargetName="BlockName" Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
        <!-- 可回看：底部主色条；只有过去的节目才需要这枚标记 -->
        <DataTrigger Binding="{Binding Replayable}" Value="True">
          <Setter TargetName="BlockReplayBar" Property="Opacity" Value="0.9"/>
        </DataTrigger>
        <!-- 时移窗口内的节目：左侧玫红竖条 -->
        <DataTrigger Binding="{Binding Timeshiftable}" Value="True">
          <Setter TargetName="BlockTimeshiftBar" Property="Opacity" Value="0.9"/>
        </DataTrigger>
        <!-- 宽段（≥140px）允许节目名折成两行 -->
        <DataTrigger Binding="{Binding WideBlock}" Value="True">
          <Setter TargetName="BlockName" Property="TextWrapping" Value="Wrap"/>
        </DataTrigger>
        <!-- 角标：只有回看 / 时移 / 预约带角标文案 -->
        <DataTrigger Binding="{Binding HasBadge}" Value="True">
          <Setter TargetName="BlockBadge" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <!-- 角标底色跟随段状态，与左侧模式 chip 取同一组主题画刷 -->
        <DataTrigger Binding="{Binding SegmentMode}" Value="Replay">
          <Setter TargetName="BlockBadge" Property="Background" Value="{DynamicResource StatusReplayFillBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding SegmentMode}" Value="Live">
          <Setter TargetName="BlockBadge" Property="Background" Value="{DynamicResource StatusLiveFillBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding SegmentMode}" Value="Timeshift">
          <Setter TargetName="BlockBadge" Property="Background" Value="{DynamicResource StatusTimeshiftFillBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding SegmentMode}" Value="Unavailable">
          <Setter TargetName="BlockBadge" Property="Background" Value="{DynamicResource StatusBookBrush}"/>
        </DataTrigger>
        <!-- 不可点击（未来的预约段、超期段）：虚线 + 弱化，放在最后以覆盖上面的状态 -->
        <DataTrigger Binding="{Binding CanPlay}" Value="False">
          <Setter TargetName="BlockDash" Property="Visibility" Value="Visible"/>
          <Setter TargetName="BlockSurface" Property="Background" Value="Transparent"/>
          <Setter TargetName="BlockSurface" Property="BorderBrush" Value="Transparent"/>
          <Setter TargetName="BlockLiveTint" Property="Opacity" Value="0"/>
          <Setter TargetName="BlockAccentTint" Property="Opacity" Value="0"/>
          <Setter TargetName="BlockReplayBar" Property="Opacity" Value="0"/>
          <Setter TargetName="BlockTimeshiftBar" Property="Opacity" Value="0"/>
          <Setter TargetName="BlockName" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
          <Setter TargetName="BlockName" Property="FontWeight" Value="Normal"/>
          <!-- Dim the plate, not the label: fading the whole block pushed the expired title below 4.5:1
               contrast in the light theme, so the name keeps its full strength and the sunken plate carries
               the "not playable" signal (together with the dashed outline). -->
          <Setter TargetName="BlockSurface" Property="Opacity" Value="0.55"/>
          <Setter TargetName="BlockRoot" Property="Cursor" Value="Arrow"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <!--
    行结构：0 紧凑进度条（无 EPG 数据时的回退，与旧版 64px 底栏一致）/ 1 节目时间线 / 2 宿主内容区。
    CompactMode 只保留第 0 行，其余折叠，宿主随之回到 64 px 的矮栏。
    列 1 是内嵌音量组，窗口模式隐藏它改用底栏自带的音量控件。
  -->
  <Grid x:Name="TimelineRoot">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="RowMeter" Height="Auto"/>
      <RowDefinition x:Name="RowBand" Height="Auto"/>
      <RowDefinition x:Name="RowBottom" Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="120"/>
    </Grid.ColumnDefinitions>

    <!-- 进度条：Minimum/Maximum 由当前节目窗口或 0..时长 驱动；节目时间线可见时它被折叠但仍保存计量值 -->
    <Slider Grid.Row="0" Grid.Column="0" x:Name="SliderSeek" Height="20" Style="{StaticResource UnifiedThickSlider}"
            VerticalAlignment="Center"
            Minimum="0" Maximum="100"
            ValueChanged="SliderSeek_ValueChanged"
            PreviewMouseDown="SliderSeek_PreviewMouseDown"
            PreviewMouseUp="SliderSeek_PreviewMouseUp"
            PreviewMouseMove="SliderSeek_MouseMove"
            MouseLeave="SliderSeek_MouseLeave"/>

    <!-- 音量区（窗口模式隐藏本组，改用底栏自带的静音/音量控件） -->
    <Grid x:Name="VolumeGroup" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Margin="12,2,0,0" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="BtnMute" Grid.Column="0" Style="{StaticResource OverlayIconButton}" ToolTip="{DynamicResource Overlay_Mute}" Click="BtnMute_Click" Margin="0,0,6,0">
        <Viewbox Width="12" Height="12">
          <Path x:Name="IconMute" Fill="{DynamicResource TextPrimaryBrush}" Data="M2,5 L2,11 L5,11 L9,15 L9,1 L5,5 Z M11,5 Q13,8 11,11 M14,3 Q17,8 14,13"/>
        </Viewbox>
      </Button>
      <controls:VolumeSlider Grid.Column="1" x:Name="SliderVolume"
                             VolumeChanged="SliderVolume_VolumeChanged"
                             VerticalAlignment="Center"/>
    </Grid>

    <!-- 节目时间线：16px 标题/翻页行 + 13px 刻度行 + 1px 分隔线 + 25px 节目段行 = 55px（原进度条是 20px） -->
    <Grid x:Name="Band" Grid.Row="1" Grid.Column="0" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="16"/>
        <RowDefinition Height="13"/>
        <RowDefinition Height="1"/>
        <RowDefinition Height="25"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BtnPrevSegment" Grid.Column="0" Style="{StaticResource TimelineNavButton}"
                Content="&#x2039;" ToolTip="{DynamicResource Timeline_PrevSegment}" Click="BtnPrevSegment_Click"/>
        <TextBlock x:Name="TxtProgrammeName" Grid.Column="1" Margin="2,0,8,0" VerticalAlignment="Center"
                   FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <!-- 当前模式角标（直播 / 回看 / 时移），颜色随模式切换 -->
        <Border x:Name="ModeChip" Grid.Column="2" CornerRadius="2" Padding="4,0" Margin="0,0,8,0"
                VerticalAlignment="Center" Visibility="Collapsed"
                Background="{DynamicResource StatusTimeshiftBrush}">
          <TextBlock x:Name="TxtModeChip" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
        </Border>
        <TextBlock x:Name="TxtWindowRange" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0"
                   FontSize="10.5" MaxWidth="190" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <Button x:Name="BtnNextSegment" Grid.Column="4" Style="{StaticResource TimelineNavButton}"
                Content="&#x203A;" ToolTip="{DynamicResource Timeline_NextSegment}" Click="BtnNextSegment_Click"/>
      </Grid>

      <!-- 刻度行：直播态也可点，点中即跳到该时刻（开启时移或直接回看），故不再屏蔽命中测试 -->
      <Canvas x:Name="RulerCanvas" Grid.Row="1" ClipToBounds="True" Background="Transparent" Cursor="Hand"
              PreviewMouseLeftButtonDown="RulerCanvas_MouseLeftButtonDown"
              MouseMove="RulerCanvas_MouseMove" MouseLeave="RulerCanvas_MouseLeave"/>

      <!-- 刻度与轨道之间的 1px 中性色分隔线，给轨道留出内凹槽的感觉 -->
      <Border Grid.Row="2" Opacity="0.12" BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource BorderBrushCommon}"/>

      <!-- 节目段轨道 -->
      <Grid Grid.Row="3">
        <Canvas x:Name="TrackCanvas" ClipToBounds="True" Background="Transparent" Cursor="SizeWE"
                SizeChanged="TrackCanvas_SizeChanged"
                PreviewMouseLeftButtonDown="TrackCanvas_MouseLeftButtonDown"
                PreviewMouseMove="TrackCanvas_MouseMove"
                PreviewMouseLeftButtonUp="TrackCanvas_MouseLeftButtonUp"
                MouseLeave="TrackCanvas_MouseLeave"/>

        <!-- 播放头 / 当前节目填充 / 直播边缘：由 code-behind 定位，画刷保持 DynamicResource 以便换肤 -->
        <Canvas x:Name="OverlayCanvas" ClipToBounds="True" IsHitTestVisible="False">
          <Border x:Name="CurrentFrame" CornerRadius="3" BorderThickness="2" Visibility="Collapsed"
                  Background="Transparent" BorderBrush="{DynamicResource AccentBrush}"/>
          <Border x:Name="ProgressFill" CornerRadius="2" Visibility="Collapsed" Opacity="0.35"
                  Background="{DynamicResource AccentBrush}"/>
          <Rectangle x:Name="LiveEdge" Width="2" Visibility="Collapsed"
                     Fill="{DynamicResource StatusTimeshiftBrush}"/>
          <Rectangle x:Name="Playhead" Width="2" Visibility="Collapsed"
                     Fill="{DynamicResource AccentBrush}"/>
          <Rectangle x:Name="PlayheadHandle" Width="7" Height="7" RadiusX="1" RadiusY="1" Visibility="Collapsed"
                     Fill="{DynamicResource AccentBrush}"/>
        </Canvas>

        <!-- 悬停刻度光标 + 结果预告气泡：与轨道同坐标系，气泡向上溢出到刻度区，仅由 code-behind 更新坐标 -->
        <Canvas x:Name="HoverLayer" ClipToBounds="False" IsHitTestVisible="False">
          <Line x:Name="HoverCursorLine" StrokeThickness="1" StrokeDashArray="3 3" Visibility="Collapsed"
                Stroke="{DynamicResource TextSecondaryBrush}"/>
          <Ellipse x:Name="HoverCursorDot" Width="6" Height="6" Visibility="Collapsed" StrokeThickness="1"
                   Fill="Transparent" Stroke="{DynamicResource TextSecondaryBrush}"/>
          <Border x:Name="HoverBubble" Height="13" CornerRadius="3" BorderThickness="1" Padding="5,0"
                  Visibility="Collapsed" Opacity="0.94"
                  Background="{DynamicResource CardBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrushCommon}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="TxtHoverTime" FontSize="8.5" FontFamily="Consolas" Margin="0,0,6,0"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock x:Name="TxtHoverName" FontSize="9.5" MaxWidth="168" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock x:Name="TxtHoverHint" FontSize="8.5" Margin="6,0,0,0"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
          </Border>
        </Canvas>
      </Grid>
    </Grid>

    <!-- 宿主内容区（窗口模式不使用；全屏浮层把按钮行放在控件外部） -->
    <ContentPresenter x:Name="BottomArea" Grid.Row="2" Grid.ColumnSpan="2"/>
  </Grid>
</UserControl>
