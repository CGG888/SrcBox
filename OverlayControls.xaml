<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:LibmpvIptvClient"
        xmlns:controls="clr-namespace:LibmpvIptvClient.Controls"
        x:Class="LibmpvIptvClient.OverlayControls"
        Title="OverlayControls"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="900" Height="80"
        ShowActivated="False"
        PreviewMouseWheel="OnPreviewMouseWheel">
    <Window.Resources>
      <local:RangeToWidthConverter x:Key="RangeToWidth"/>

      <!-- Playback Status Indicator Style -->
      <Style x:Key="StatusIndicatorStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource StatusIndicatorBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
      </Style>

      <Style x:Key="OverlayTagChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ChipButtonBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ChipButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
      </Style>

      <!-- 基础按钮样式 -->
      <Style x:Key="OverlayButtonBase" TargetType="{x:Type ButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ChipButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ChipButtonPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
      </Style>
      
      <Style x:Key="OverlayIconButton" TargetType="Button" BasedOn="{StaticResource OverlayButtonBase}"/>
      
      <Style x:Key="OverlayToggle" TargetType="ToggleButton" BasedOn="{StaticResource OverlayButtonBase}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </Window.Resources>

  <Border Background="{DynamicResource TopOverlayScrimBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushCommon}" BorderThickness="1">
      <Grid Margin="12,0">
        <!-- Status Indicator (Moved to separate Canvas/Popup if needed, but here it's part of controls) -->
        <!-- Actually, user wants it in the bottom-left of video area. OverlayControls is bottom bar. -->
        <!-- We can add it to the left side of the controls or use a separate window. -->
        <!-- Given the user request, it's better to add it to this window but position it absolutely? -->
        <!-- No, OverlayControls window is only the bottom bar. We need a new window or modify this one to cover full screen? -->
        <!-- Wait, the user said "Red marked area" which implies bottom-left of SCREEN/VIDEO. -->
        <!-- OverlayControls is usually at the bottom center. -->
        <!-- Let's add it to the left of the play button. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 进度条 -->
                <RowDefinition Height="*"/>    <!-- 按钮 -->
            </Grid.RowDefinitions>


            <!-- 进度条行（右侧追加音量滑块） -->
            <Grid Grid.Row="0" Margin="0,0,0,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Slider Grid.Column="0" x:Name="SliderSeek" Height="20" Style="{StaticResource UnifiedThickSlider}" 
                    Minimum="0" Maximum="100" 
                    ValueChanged="SliderSeek_ValueChanged" 
                    PreviewMouseDown="SliderSeek_PreviewMouseDown"
                    PreviewMouseUp="SliderSeek_PreviewMouseUp"
                    PreviewMouseMove="SliderSeek_MouseMove"
                    MouseLeave="SliderSeek_MouseLeave"/>
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnMute" Grid.Column="0" Style="{StaticResource OverlayIconButton}" ToolTip="{DynamicResource Overlay_Mute}" Click="BtnMute_Click" Margin="0,0,6,0">
                    <ui:SymbolIcon x:Name="IconMute" Symbol="Volume" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
                <controls:VolumeSlider Grid.Column="1" x:Name="SliderVolume"
                                       IsMuted="{Binding IsMuted, Mode=OneWay}"
                                       VolumeChanged="SliderVolume_VolumeChanged"
                                       VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- 按钮行 -->
        <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- 左 -->
                <ColumnDefinition Width="*"/>    <!-- 中 -->
                <ColumnDefinition Width="Auto"/> <!-- 右 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧：播放控制 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!-- Status Indicator (Left of controls) -->
                <Border x:Name="StatusIndicatorInner" Style="{StaticResource StatusIndicatorStyle}" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed">
                    <TextBlock x:Name="TxtStatusInner" Text="{DynamicResource EPG_Status_Live}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold"/>
                </Border>

                <Button x:Name="BtnPlayPause" Style="{StaticResource OverlayIconButton}" Click="BtnPlayPause_Click">
                    <Viewbox Width="12" Height="12" Stretch="Uniform">
                        <Path x:Name="IconPlayPause" Fill="{DynamicResource TextPrimaryBrush}" Data="M4,2 L12,8 L4,14 Z"/>
                    </Viewbox>
                </Button>
                <Button x:Name="BtnStop" Style="{StaticResource OverlayIconButton}" Click="BtnStop_Click">
                    <Viewbox Width="12" Height="12" Stretch="Uniform">
                        <Path Fill="{DynamicResource TextPrimaryBrush}" Data="M3,3 H13 V13 H3 Z"/>
                    </Viewbox>
                </Button>
                <Button x:Name="BtnRew" Style="{StaticResource OverlayIconButton}" Click="BtnRew_Click">
                    <Viewbox Width="12" Height="12" Stretch="Uniform">
                        <Path Fill="{DynamicResource TextPrimaryBrush}" Data="M8,2 L2,8 L8,14 M12,2 V14"/>
                    </Viewbox>
                </Button>
                <Button x:Name="BtnFwd" Style="{StaticResource OverlayIconButton}" Click="BtnFwd_Click">
                    <Viewbox Width="12" Height="12" Stretch="Uniform">
                        <Path Fill="{DynamicResource TextPrimaryBrush}" Data="M4,2 L10,8 L4,14 M0,2 V14"/>
                    </Viewbox>
                </Button>
                
                <!-- 时间信息 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="LblElapsed" Text="00:00" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Text=" / " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="LblDuration" Text="00:00" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
                <WrapPanel x:Name="TagPanelOverlay" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>

            <!-- 中间：状态信息（与窗口保持一致，隐藏文本） -->
            <TextBlock x:Name="LblInfo" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>

            <!-- 右侧：工具 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <!-- FCC/UDP removed from here -->
                <Button x:Name="BtnSources" Style="{StaticResource OverlayIconButton}" ToolTip="{DynamicResource Overlay_SwitchSource}" Click="BtnSourceMenu_Click">
                    <ContentControl x:Name="BtnSourcesIcon"/>
                </Button>
                <Button x:Name="BtnRatio" Style="{StaticResource OverlayIconButton}" ToolTip="{DynamicResource Overlay_AspectRatio}" Click="BtnRatio_Click">
                    <ContentControl x:Name="BtnRatioIcon"/>
                </Button>
                <!-- 倍速按钮：采用 OverlayToggle 样式以适配文本宽度，保持与现有按钮配色一致 -->
                <ToggleButton x:Name="BtnSpeed" Style="{StaticResource OverlayToggle}" ToolTip="Speed" Click="BtnSpeed_Click">
                    <TextBlock x:Name="LblSpeed" Text="1.0x" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </ToggleButton>
                <ToggleButton x:Name="CbTimeshift" Style="{StaticResource OverlayToggle}" ToolTip="{DynamicResource Overlay_Timeshift}">
                    <Viewbox Width="12" Height="12" Stretch="Uniform">
                        <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" Data="M6,1 A5,5 0 1,1 6,11 A5,5 0 1,1 6,1 M6,3 V6.5 L8.5,8"/>
                    </Viewbox>
                </ToggleButton>
                
                <ToggleButton x:Name="CbEpg" Style="{StaticResource OverlayToggle}" ToolTip="{DynamicResource Overlay_EPG}" Click="CbEpg_Checked">
                    <Viewbox Width="12" Height="12" Stretch="Uniform">
                        <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" Data="M2,3 V13 H14 V3 Z M2,5 H14 M5,1 V3 M11,1 V3"/>
                    </Viewbox>
                </ToggleButton>

                <ToggleButton x:Name="CbDrawer" Style="{StaticResource OverlayToggle}" ToolTip="{DynamicResource Overlay_ToggleDrawer}" Click="CbDrawer_Checked">
                    <Viewbox Width="12" Height="12" Stretch="Uniform">
                        <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" Data="M2,4 H14 M2,8 H14 M2,12 H14 M5,4 V4.01 M5,8 V8.01 M5,12 V12.01"/>
                    </Viewbox>
                </ToggleButton>
            </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
