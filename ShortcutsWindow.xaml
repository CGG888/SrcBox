<Window x:Class="LibmpvIptvClient.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Shortcuts_Title}"
        Height="500" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Border Background="#E6000000" BorderBrush="{DynamicResource BorderBrushCommon}" BorderThickness="1" CornerRadius="12" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Text="{DynamicResource Shortcuts_WindowTitle}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Shortcuts Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 播放控制 -->
                    <TextBlock Text="{DynamicResource Shortcuts_Playback}" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Space" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Shortcuts_PlayPause}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="S" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Shortcuts_Stop}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="&#x2190; / &#x2192;" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Shortcuts_SeekTimeshift}" Foreground="White" Margin="20,0,0,4" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="&#x2191; / &#x2193;" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Shortcuts_PrevNextChannel}" Foreground="White" Margin="20,0,0,4"/>
                    </Grid>

                    <!-- 界面控制 -->
                    <TextBlock Text="{DynamicResource Shortcuts_Interface}" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Enter" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Shortcuts_Fullscreen}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="L" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Shortcuts_ChannelList}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+Shift+L" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Shortcuts_MinimalMode}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="E" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Shortcuts_EpgToggle}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Shortcuts_DoubleClickVideo}" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{DynamicResource Shortcuts_Fullscreen}" Foreground="White" Margin="20,0,0,4"/>
                    </Grid>

                    <!-- 文件/频道 -->
                    <TextBlock Text="{DynamicResource Shortcuts_FileChannel}" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+O" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Shortcuts_OpenFile}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+U" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Shortcuts_OpenUrl}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+N" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Shortcuts_AddFile}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+B" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Shortcuts_AddUrl}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl+M" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{DynamicResource Shortcuts_ManageChannels}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="F5" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{DynamicResource Shortcuts_RefreshChannels}" Foreground="White" Margin="20,0,0,4"/>
                    </Grid>

                    <!-- 音量 -->
                    <TextBlock Text="{DynamicResource Shortcuts_Volume}" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="M" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Shortcuts_Mute}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="= / +" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Shortcuts_VolumeUp}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="- / Num-" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Shortcuts_VolumeDown}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Shortcuts_MouseWheel}" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Shortcuts_VolumeAdjust}" Foreground="White" Margin="20,0,0,4"/>
                    </Grid>

                    <!-- 其他 -->
                    <TextBlock Text="{DynamicResource Shortcuts_Other}" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="F1" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Shortcuts_DebugWindow}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+," Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Shortcuts_Settings}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+I" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Shortcuts_About}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+/" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Shortcuts_ShortcutsHelp}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="ESC" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{DynamicResource Shortcuts_ExitMinimal}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Alt+F4" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{DynamicResource Shortcuts_Exit}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="R" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{DynamicResource Shortcuts_Record}" Foreground="White" Margin="20,0,0,4"/>
                    </Grid>

                    <!-- 时移模式 -->
                    <TextBlock Text="{DynamicResource Shortcuts_TimeshiftMode}" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+&#x2191; / &#x2193;" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Shortcuts_PrevNextProgram}" Foreground="White" Margin="20,0,0,4"/>
                    </Grid>

                    <!-- 多屏播放 -->
                    <TextBlock Text="{DynamicResource Shortcuts_MultiScreen}" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+4" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Shortcuts_4Screen}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+6" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Shortcuts_6Screen}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+9" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Shortcuts_9Screen}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ESC" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Shortcuts_ExitFullscreen}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="1-9" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{DynamicResource Shortcuts_SelectScreen}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="&#x2191; / &#x2193;" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{DynamicResource Shortcuts_PrevNextChannel}" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="&#x2190; / &#x2192;" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{DynamicResource Shortcuts_SwitchSource}" Foreground="White" Margin="20,0,0,4"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Center">
                <Button x:Name="BtnClose" Content="{DynamicResource Common_Close}" Click="BtnClose_Click" HorizontalAlignment="Center" Width="100" Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
