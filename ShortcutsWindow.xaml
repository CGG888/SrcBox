<Window x:Class="LibmpvIptvClient.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键"
        Height="500" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Border Background="#E6000000" BorderBrush="{DynamicResource BorderBrushCommon}" BorderThickness="1" CornerRadius="12" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Text="快捷键说明" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Shortcuts Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 播放控制 -->
                    <TextBlock Text="播放控制" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Space" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="播放/暂停" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="S" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="停止" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="← / →" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="快退/快进（时移模式）&#x0a;切换上一/下一源（正常模式）" Foreground="White" Margin="20,0,0,4" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="↑ / ↓" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="上一频道 / 下一频道" Foreground="White" Margin="20,0,0,4"/>
                    </Grid>

                    <!-- 界面控制 -->
                    <TextBlock Text="界面控制" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Enter" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="全屏切换" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="L" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="频道列表" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+Shift+L" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="精简模式" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="E" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="EPG开关" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="双击视频区" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="全屏切换" Foreground="White" Margin="20,0,0,4"/>
                    </Grid>

                    <!-- 文件/频道 -->
                    <TextBlock Text="文件/频道" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+O" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="打开文件" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+U" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="打开链接" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+N" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="添加文件" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+B" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="添加链接" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl+M" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="管理频道数据" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="F5" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="刷新频道" Foreground="White" Margin="20,0,0,4"/>
                    </Grid>

                    <!-- 音量 -->
                    <TextBlock Text="音量" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="M" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="静音" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="= / +" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="音量+" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="- / 小键盘-" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="音量-" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="滚轮" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="音量调节" Foreground="White" Margin="20,0,0,4"/>
                    </Grid>

                    <!-- 其他 -->
                    <TextBlock Text="其他" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="F1" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="调试窗口" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+," Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="设置" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+I" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="关于" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+/" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="快捷键说明" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="ESC" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="退出精简模式" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Alt+F4" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="退出" Foreground="White" Margin="20,0,0,4"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="R" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="开始/停止录制" Foreground="White" Margin="20,0,0,4"/>
                    </Grid>

                    <!-- 时移模式 -->
                    <TextBlock Text="时移模式（附加）" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+↑ / ↓" Foreground="#FFD0D0D0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="上一节目 / 下一节目" Foreground="White" Margin="20,0,0,4"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Center">
                <Button x:Name="BtnClose" Content="关闭" Click="BtnClose_Click" HorizontalAlignment="Center" Width="100" Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>