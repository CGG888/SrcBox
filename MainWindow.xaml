<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:local="clr-namespace:LibmpvIptvClient"
        xmlns:controls="clr-namespace:LibmpvIptvClient.Controls"
        xmlns:helpers="clr-namespace:LibmpvIptvClient.Helpers"
        x:Class="LibmpvIptvClient.MainWindow"
        Title="{DynamicResource App_Name}" Width="1024" Height="768" WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        AllowDrop="True" Drop="OnDrop"
        Icon="pack://application:,,,/srcbox.ico">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="4" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                        <Setter Property="Margin" Value="8"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.Resources>
            <BitmapImage x:Key="DefaultLogo" UriSource="srcbox.ico"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:RangeToWidthConverter x:Key="RangeToWidth"/>
            <local:BoolToStarConverter x:Key="BoolToStar"/>
            
            <!-- 基础按钮样式 -->
            <Style x:Key="BarButtonBase" TargetType="{x:Type ButtonBase}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ButtonBase}">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BarButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="FontSize" Value="12"/> <!-- Adjusted to match top icon visual size -->
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BarToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="FontSize" Value="12"/> <!-- Adjusted to match top icon visual size -->
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- Title Bar Styles -->
            <Style x:Key="TopBtnStyle" TargetType="ButtonBase">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ButtonBase">
                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TitleBtnStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="▼" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TagChip" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ChipButtonBackgroundBrush}"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ChipButtonBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4,1"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
            </Style>
            <!-- 抽屉顶部操作按钮（统一芯片风格） -->
            <Style x:Key="ActionChipButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{DynamicResource ChipButtonBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ChipButtonBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="MinWidth" Value="82"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ChipButtonHoverBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ChipButtonBorderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ChipButtonPressedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ItemActionChipButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ActionChipButton}">
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="MinWidth" Value="40"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="FontSize" Value="10"/>
            </Style>
            <Style x:Key="IconGlyphButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="bd" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <local:ListIndexConverter x:Key="IndexConverter"/>
            <local:AsyncImageConverter x:Key="AsyncImage"/>
            <local:StringToVisibilityConverter x:Key="StringToVis"/>

            <!-- ContextMenu Styles -->
            <Style TargetType="{x:Type ContextMenu}">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCommon}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ContextMenu}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="4">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type MenuItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/> <!-- Align with global menu first column -->
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Icon / Checkmark Area -->
                                    <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <Path x:Name="CheckMark" Data="M1,5 L4.5,8.5 L9,1" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="False"/>

                                    <!-- Content -->
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    
                                    <!-- Shortcut -->
                                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="16,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                    <!-- Arrow for Submenu -->
                                    <Path x:Name="Arrow" Grid.Column="3" Data="M0,0 L4,3.5 L0,7" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    
                                    <!-- Popup for Submenu -->
                                    <Popup x:Name="Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                        <Border x:Name="SubmenuBorder" SnapsToDevicePixels="True" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushCommon}" BorderThickness="1" CornerRadius="6" Padding="4" Grid.IsSharedSizeScope="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="True">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ChipButtonHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                     <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                     <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="Icon" Value="{x:Null}">
                                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Separator}">
                <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Separator}">
                            <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" SnapsToDevicePixels="True"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="EpgColumn" Width="0"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="DrawerColumn" Width="{Binding DrawerGridLength}"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto">
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="Auto"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowStateActions.IsFullscreen}" Value="True">
                                <Setter Property="Height" Value="0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMinimalMode}" Value="True">
                                <Setter Property="Height" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
            <RowDefinition Height="*"/>    <!-- 视频区 -->
            <RowDefinition Height="Auto"/> <!-- 底部控制栏 -->
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource TitleBarBrush}" Height="40" BorderBrush="{DynamicResource BorderBrushCommon}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMinimalMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Icon & Dropdown Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0">
                    <Button x:Name="BtnAppTitle" Click="BtnAppTitle_Click" Style="{StaticResource TitleBtnStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/srcbox.png" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource App_Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Window Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 1. Topmost (Pin) -->
                    <ToggleButton x:Name="BtnPin" Style="{StaticResource TopBtnStyle}" Click="BtnPin_Click" ToolTip="{DynamicResource Tooltip_PinTop}">
                        <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center"
                              Data="M8,15 V11 M4,11 H12 M5,11 V5 H11 V11 M4,5 H12"/>
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bd" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}"/>
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <!-- Pinned State (Yellow) -->
                                                <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Data="M8,15 V11 M4,11 H12 M5,11 V5 H11 V11 M4,5 H12"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- 2. Minimize -->
                    <Button x:Name="BtnMin" Style="{StaticResource TopBtnStyle}" Click="BtnMin_Click">
                        <Path Data="M4,12 H12" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- 3. Maximize/Restore -->
                    <Button x:Name="BtnMax" Style="{StaticResource TopBtnStyle}" Click="BtnMax_Click">
                         <!-- Auto-switching icon based on WindowState -->
                        <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="M4.5,4.5 H11.5 V11.5 H4.5 Z"/> <!-- Square (Maximize) -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                                            <Setter Property="Data" Value="M4.5,6.5 H9.5 V11.5 H4.5 Z M6.5,6.5 V4.5 H11.5 V9.5 H9.5"/> <!-- Double Square (Restore) -->
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    
                    <!-- 4. Fullscreen (Yellow when Checked) -->
                    <ToggleButton x:Name="BtnWinFullscreen" Style="{StaticResource TopBtnStyle}" Click="CbFullscreen_Checked" IsChecked="{Binding WindowStateActions.IsFullscreen, Mode=OneWay}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bd" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}"/>
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <Path Data="M3.5,6.5 V3.5 H6.5 M9.5,3.5 H12.5 V6.5 M12.5,9.5 V12.5 H9.5 M6.5,12.5 H3.5 V9.5" 
                                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <Path Data="M3.5,6.5 V3.5 H6.5 M9.5,3.5 H12.5 V6.5 M12.5,9.5 V12.5 H9.5 M6.5,12.5 H3.5 V9.5" 
                                                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <ToggleButton x:Name="BtnMinimalTop" Style="{StaticResource TopBtnStyle}" Click="BtnMinimal_Click" IsChecked="{Binding IsMinimalMode, Mode=OneWay}" ToolTip="{DynamicResource Overlay_ToggleMinimal}">
                        <Path Data="M4,6 H12 M4,9 H12 M4,12 H12" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </ToggleButton>

                    <!-- 5. Close -->
                    <Button x:Name="BtnClose" Click="BtnClose_Click" Background="Transparent">
                        <Button.Style>
                            <Style TargetType="ButtonBase" BasedOn="{StaticResource TopBtnStyle}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M4.5,4.5 L11.5,11.5 M11.5,4.5 L4.5,11.5" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 左侧 EPG 抽屉 (Row 1，底部有边框) -->
        <Grid x:Name="EpgPanel" Grid.Row="1" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" Visibility="Collapsed">
             <!-- ... EPG Content (Same as before) ... -->
             <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="12,16,12,8">
                <TextBlock Text="{DynamicResource EPG_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" DockPanel.Dock="Left"/>
                <Button x:Name="BtnEpgCollapse" DockPanel.Dock="Right" Style="{StaticResource BarButton}" ToolTip="{DynamicResource EPG_Collapse}" Click="BtnEpgCollapse_Click">
                    <Path Data="M6,0 L0,4 L6,8" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                <TextBlock x:Name="LblEpgChannel" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="12,2,0,0" TextTrimming="CharacterEllipsis" 
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </DockPanel>
            <Grid Grid.Row="1" Margin="12,0,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnPrevDay" Grid.Column="0" Click="BtnPrevDay_Click" Style="{StaticResource BarButton}" Width="60" Background="{DynamicResource ChipButtonBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushCommon}" BorderThickness="1" ToolTip="{DynamicResource EPG_PrevDay}">
                    <TextBlock Text="{DynamicResource EPG_PrevDay}" FontSize="12"/>
                </Button>
                <Border Grid.Column="1" Background="{StaticResource AccentBrush}" CornerRadius="4" Margin="12,0" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="TxtCurrentDate" Text="{DynamicResource EPG_Today}" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                </Border>
                <Button x:Name="BtnNextDay" Grid.Column="2" Click="BtnNextDay_Click" Style="{StaticResource BarButton}" Width="60" Background="{DynamicResource ChipButtonBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushCommon}" BorderThickness="1" ToolTip="{DynamicResource EPG_NextDay}">
                    <TextBlock Text="{DynamicResource EPG_NextDay}" FontSize="12"/>
                </Button>
            </Grid>
            <ListBox x:Name="ListEpg" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,0,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListEpg_PreviewMouseLeftButtonDown"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="RowBd" Background="{TemplateBinding Background}" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ChipButtonHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ChipButtonPressedBrush}"/>
                                        </Trigger>
                                        <!-- 当前播放节目高亮 -->
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource ChipButtonPressedBrush}"/>
                                        </DataTrigger>
                                        <!-- 回放播放中：增加左侧彩色标识（深浅色均明显） -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPlaying}" Value="True"/>
                                                <Condition Binding="{Binding Status}" Value="回放"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource StatusReplayBrush}"/>
                                            <Setter TargetName="RowBd" Property="BorderThickness" Value="4,0,0,1"/>
                                        </MultiDataTrigger>
                                        <!-- 直播播放中：增加左侧彩色标识 -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPlaying}" Value="True"/>
                                                <Condition Binding="{Binding Status}" Value="直播"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource StatusLiveBrush}"/>
                                            <Setter TargetName="RowBd" Property="BorderThickness" Value="4,0,0,1"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPlaying}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.PlaybackMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Timeshift"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource StatusTimeshiftBrush}"/>
                                            <Setter TargetName="RowBd" Property="BorderThickness" Value="4,0,0,1"/>
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Start, StringFormat=HH:mm}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock Text="{Binding End, StringFormat=HH:mm}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Visibility="{Binding Description, Converter={StaticResource StringToVis}}"/>
                            </StackPanel>
                            <Grid Grid.Column="2">
                                <!-- 状态芯片做成可点击按钮（仅直播可点击），带阴影更立体 -->
                                <Button x:Name="BtnStatusChip" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Padding="10,2" MinWidth="60" Height="26" Click="EpgLiveChip_Click" Cursor="Arrow">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Chip" CornerRadius="6" Background="{DynamicResource ChipButtonBackgroundBrush}" BorderBrush="{DynamicResource ChipButtonBorderBrush}" BorderThickness="1">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.25"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <TextBlock x:Name="TxtStatusChip" Text="{Binding Status}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                               FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- 预约状态隐藏（由预约按钮接管） -->
                                                <DataTrigger Binding="{Binding Status}" Value="预约">
                                                    <Setter Property="UIElement.Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <!-- 回放：绿色填充，禁用点击，指针正常 -->
                                                <DataTrigger Binding="{Binding Status}" Value="回放">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusReplayFillBrush}"/>
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource StatusReplayFillBrush}"/>
                                                    <Setter TargetName="TxtStatusChip" Property="Foreground" Value="#FFFFFFFF"/>
                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                </DataTrigger>
                                                <!-- 直播：红色填充，可点击播放，指针为手形 -->
                                                <DataTrigger Binding="{Binding Status}" Value="直播">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusLiveFillBrush}"/>
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource StatusLiveFillBrush}"/>
                                                    <Setter TargetName="TxtStatusChip" Property="Foreground" Value="#FFFFFFFF"/>
                                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsPlaying}" Value="True"/>
                                                        <Condition Binding="{Binding DataContext.PlaybackMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Timeshift"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusTimeshiftFillBrush}"/>
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource StatusTimeshiftFillBrush}"/>
                                                    <Setter TargetName="TxtStatusChip" Property="Foreground" Value="#FFFFFFFF"/>
                                                    <Setter TargetName="TxtStatusChip" Property="Text" Value="{DynamicResource EPG_Status_Timeshift}"/>
                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                </MultiDataTrigger>
                                                <!-- 悬停/按下立体感 -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chip" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.35"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Chip" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <!-- 预约按钮（同位置），仅未来节目显示；已预约则禁用并显示“已预约” -->
                                <Button Margin="0,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Height="26" MinWidth="60"
                                        Click="EpgRemindButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Padding" Value="10,2"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Content" Value="{DynamicResource EPG_Remind}"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="预约">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                                    <Setter Property="Background" Value="{DynamicResource StatusBookBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource StatusBookBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBooked}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Content" Value="{DynamicResource EPG_Status_Booked}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrushCommon}" BorderThickness="0,0,0,1"/>
        </Grid>

        <!-- 视频区域 -->
        <Grid Grid.Row="1" Grid.Column="1" Background="Black" PreviewMouseWheel="VideoArea_PreviewMouseWheel" MouseLeftButtonDown="VideoArea_MouseLeftButtonDown" MouseMove="VideoArea_MouseMove">
            <wfi:WindowsFormsHost x:Name="VideoHost" Background="Black" PreviewMouseWheel="VideoHost_PreviewMouseWheel" PreviewMouseMove="VideoHost_PreviewMouseMove">
                <wf:Panel x:Name="VideoPanel" BackColor="Black"/>
            </wfi:WindowsFormsHost>
            
            <!-- Placeholder (Visible when not playing) -->
            <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible" IsHitTestVisible="False">
                <Image Source="/srcbox.png" Width="64" Height="64" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{DynamicResource App_Name}" Foreground="#EEEEEE" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource App_DescShort}" Foreground="#CCCCCC" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Playback Status Indicator (Live/Catchup) -->
            <Border x:Name="PlaybackStatusIndicator" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,140" 
                    Background="{DynamicResource StatusIndicatorBackgroundBrush}" CornerRadius="4" Padding="8,4" Visibility="{Binding PlaybackStatusText, Converter={StaticResource StringToVis}}" IsHitTestVisible="False">
                <TextBlock x:Name="TxtPlaybackStatus" Text="{Binding PlaybackStatusText}" Foreground="{Binding PlaybackStatusBrush}" FontSize="14" FontWeight="Bold"/>
            </Border>
        </Grid>

        <!-- 右侧频道/分组抽屉 (Row 1，底部有边框) -->
        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushCommon}" BorderThickness="1,0,0,1" x:Name="DrawerPanel">
             <!-- ... Drawer Content (Same as before) ... -->
             <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="12,16,12,8">
                    <TextBlock Text="{DynamicResource Drawer_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" DockPanel.Dock="Left"/>
                    <Button x:Name="BtnDrawerCollapse" DockPanel.Dock="Right" Style="{StaticResource BarButton}" ToolTip="{DynamicResource Drawer_Collapse}" Click="BtnDrawerCollapse_Click" HorizontalAlignment="Right">
                        <Path Data="M0,0 L6,4 L0,8" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </DockPanel>
                
                <!-- 抽屉顶部（标签式导航） -->
                <TabControl Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" x:Name="DrawerTabs">
                    <TabControl.Resources>
                        <Style x:Key="DarkTabItem" TargetType="{x:Type TabItem}">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type TabItem}">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChipButtonHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChipButtonHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <TabControl.ItemContainerStyle>
                        <StaticResource ResourceKey="DarkTabItem"/>
                    </TabControl.ItemContainerStyle>
                    <TabItem Header="{DynamicResource Tab_AllChannels}" x:Name="TabAll">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- 搜索区 -->
                            <Grid Grid.Row="0" Margin="10,10,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CbM3uList" Grid.Column="0" Height="30" Width="140" DisplayMemberPath="Name" IsEditable="True" SelectionChanged="CbM3uList_SelectionChanged" ToolTip="{DynamicResource Drawer_M3uList}" Background="{DynamicResource ChipButtonBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox x:Name="TxtSearch" Grid.Column="1" Height="30" Background="{DynamicResource ChipButtonBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" VerticalContentAlignment="Center" Padding="6,0" TextChanged="TxtSearch_TextChanged" />
                                <Button x:Name="BtnClearSearch" Grid.Column="2" Content="{DynamicResource Drawer_Clear}" Margin="8,0,0,0" Click="BtnClearSearch_Click" Style="{StaticResource ItemActionChipButton}"/>
                                <Button x:Name="BtnChannelsRefresh" Grid.Column="3" Content="{DynamicResource Drawer_Recordings_Refresh}" Margin="8,0,0,0" Click="BtnChannelsRefresh_Click" Style="{StaticResource ItemActionChipButton}"/>
                            </Grid>
                            <!-- 列表区 -->
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="TxtCount" Grid.Row="0" Margin="10,0,10,5" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <ListBox x:Name="ListChannels" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         MouseEnter="ListChannels_MouseEnter"
                                         AlternationCount="2">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="true">
                                                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="true">
                                                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="ItemBorder" Margin="6,4,6,4" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown" BorderThickness="1" BorderBrush="{DynamicResource BorderBrushCommon}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter Property="Background" Value="{DynamicResource ChipButtonHoverBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ChipButtonHoverBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid Margin="8,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding GlobalIndex}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                                                    <Ellipse Grid.Column="2" Width="6" Height="6" Fill="#35C759" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Playing}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="4,0,0,0">
                                                                <TextBlock Text="R" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" 
                                                                           Margin="0,2,0,0"
                                                                           Visibility="{Binding HasCatchup, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource Channel_CatchupAvailable}"/>
                                                                <TextBlock Text="T" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" 
                                                                           Margin="4,2,0,0"
                                                                           Visibility="{Binding HasTimeshift, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource Channel_TimeshiftAvailable}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Group}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding CurrentProgramTitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Visibility="{Binding CurrentProgramTitle, Converter={StaticResource StringToVis}}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="5" Style="{StaticResource BarButton}" Click="ToggleFavorite_Click" ToolTip="{DynamicResource Favorite_Toggle}">
                                                        <TextBlock Text="{Binding Favorite, Converter={StaticResource BoolToStar}}" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </Button>
                                                    <Border Grid.Column="6" Width="80" Height="40" Background="{DynamicResource ChipButtonBackgroundBrush}" CornerRadius="8" HorizontalAlignment="Right">
                                                        <Image helpers:ImageExtensions.RemoteUrl="{Binding Logo}" Stretch="Uniform" Width="80" Height="40"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{DynamicResource Tab_Groups}" x:Name="TabGroups">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- 搜索区 -->
                            <Grid Grid.Row="0" Margin="10,10,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CbM3uListGroups" Grid.Column="0" Height="30" Width="140" DisplayMemberPath="Name" IsEditable="True" SelectionChanged="CbM3uList_SelectionChanged" ToolTip="{DynamicResource Drawer_M3uList}" Background="{DynamicResource ChipButtonBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox x:Name="TxtSearchGroups" Grid.Column="1" Height="30" Background="{DynamicResource ChipButtonBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" VerticalContentAlignment="Center" Padding="6,0" TextChanged="TxtSearchGroups_TextChanged" />
                                <Button x:Name="BtnClearSearchGroups" Grid.Column="2" Content="{DynamicResource Drawer_Clear}" Margin="8,0,0,0" Click="BtnClearSearchGroups_Click" Style="{StaticResource ItemActionChipButton}"/>
                                <Button x:Name="BtnChannelsRefreshGroups" Grid.Column="3" Content="{DynamicResource Drawer_Recordings_Refresh}" Margin="8,0,0,0" Click="BtnChannelsRefreshGroups_Click" Style="{StaticResource ItemActionChipButton}"/>
                            </Grid>
                            <!-- 列表区 -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="6,6,6,6" Background="Transparent">
                            <ItemsControl x:Name="ListGroups" >
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander IsExpanded="False" Margin="0,4,0,0" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                                            <Expander.Header>
                                                <DockPanel LastChildFill="True" Margin="6,4">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                    <TextBlock Text="{Binding Count, StringFormat=(\{0\})}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Right"/>
                                                </DockPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Items}" AlternationCount="2">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="6,8,6,0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown">
                                                            <Grid Margin="8,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="16"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="36"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding DisplayIndex}"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                                                                <Ellipse Grid.Column="2" Width="6" Height="6" Fill="#35C759" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Playing}" Value="True">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="4,0,0,0">
                                                                            <TextBlock Text="R" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" 
                                                                                       Margin="0,2,0,0"
                                                                                       Visibility="{Binding HasCatchup, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource Channel_CatchupAvailable}"/>
                                                                            <TextBlock Text="T" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" 
                                                                                       Margin="4,2,0,0"
                                                                                       Visibility="{Binding HasTimeshift, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource Channel_TimeshiftAvailable}"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Group}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding CurrentProgramTitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Visibility="{Binding CurrentProgramTitle, Converter={StaticResource StringToVis}}"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="5" Style="{StaticResource BarButton}" Click="ToggleFavorite_Click" ToolTip="{DynamicResource Favorite_Toggle}">
                                                                    <TextBlock Text="{Binding Favorite, Converter={StaticResource BoolToStar}}" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                </Button>
                                                                <Border Grid.Column="6" Width="80" Height="40" Background="{DynamicResource ChipButtonBackgroundBrush}" CornerRadius="8" HorizontalAlignment="Right">
                                                                    <Image helpers:ImageExtensions.RemoteUrl="{Binding Logo}" Stretch="Uniform" Width="80" Height="40"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{DynamicResource Tab_History}" x:Name="TabHistory">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="12,12,12,8">
                                <TextBlock Text="{DynamicResource History_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnHistoryDelete" Content="{DynamicResource History_DeleteSelected}" Click="BtnHistoryDelete_Click" Style="{StaticResource ItemActionChipButton}"/>
                                    <Button x:Name="BtnHistoryClear" Content="{DynamicResource History_ClearAll}" Click="BtnHistoryClear_Click" Style="{StaticResource ItemActionChipButton}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="ListHistory" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,0,10,0" SelectionMode="Extended" MouseDoubleClick="ListHistory_MouseDoubleClick"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="6,8,6,0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6">
                                            <Grid Margin="8,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Visibility="Collapsed"/>
                                                <Ellipse Grid.Column="2" Width="6" Height="6" Fill="#0A84FF" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <Border Style="{StaticResource TagChip}">
                                                            <TextBlock Text="{Binding PlayTypeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Group}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SourceUrl}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="6" Width="80" Height="40" Background="{DynamicResource ChipButtonBackgroundBrush}" CornerRadius="8" HorizontalAlignment="Right">
                                                    <Image helpers:ImageExtensions.RemoteUrl="{Binding Logo}" Stretch="Uniform" Width="80" Height="40"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{DynamicResource Drawer_Recordings_Tab}" x:Name="TabRecordings">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="12,12,12,8">
                                <Grid DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtRecordingsSearch" Grid.Column="0" Height="30" Background="{DynamicResource ChipButtonBackgroundBrush}" 
                                             Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" VerticalContentAlignment="Center" Padding="6,0"
                                             TextChanged="TxtRecordingsSearch_TextChanged" />
                                    <Button x:Name="BtnRecordingsSearchClear" Grid.Column="1" Content="{DynamicResource Drawer_Clear}" Margin="8,0,0,0"
                                            Click="BtnRecordingsSearchClear_Click" Style="{StaticResource ItemActionChipButton}"/>
                                    <Button x:Name="BtnRecordingsRefresh" Grid.Column="2" Content="{DynamicResource Drawer_Recordings_Refresh}" Click="BtnRecordingsRefresh_Click" 
                                            Style="{StaticResource ItemActionChipButton}" Margin="8,0,0,0"/>
                                </Grid>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" Margin="10,0,10,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock x:Name="TxtRecordingsCount" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    <ItemsControl x:Name="ListRecordingsGrouped" Margin="0,0,0,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander IsExpanded="False" Margin="0,4,0,0" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                          Loaded="RecordingGroup_Loaded" Expanded="RecordingGroup_Expanded" Collapsed="RecordingGroup_Collapsed">
                                                    <Expander.Header>
                                                        <DockPanel LastChildFill="True" Margin="6,4">
                                                            <TextBlock Text="{Binding Channel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                            <TextBlock Text="{Binding Count, StringFormat=(\{0\})}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Right"/>
                                                        </DockPanel>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="6,8,6,0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrushCommon}" BorderThickness="1"
                                                                        PreviewMouseRightButtonUp="RecordingItem_ContextMenu">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource ChipButtonPressedBrush}"/>
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource StatusReplayBrush}"/>
                                                                                    <Setter Property="BorderThickness" Value="4,0,0,1"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Grid Margin="10,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="80"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0">
                                                                            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                                                <Setter Property="Foreground" Value="{DynamicResource StatusReplayBrush}"/>
                                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                                <Border Style="{StaticResource TagChip}">
                                                                                    <TextBlock Text="{Binding StartTime, StringFormat=yyyy-MM-dd HH:mm}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                                                                </Border>
                                                                                <Border Style="{StaticResource TagChip}" Margin="6,0,0,0">
                                                                                    <TextBlock Text="{Binding EndLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                                                                </Border>
                                                                            </StackPanel>
                                                                            <WrapPanel Margin="0,4,0,0" ItemWidth="Auto" ItemHeight="Auto">
                                                                                <Border Style="{StaticResource TagChip}" Visibility="{Binding SourceLabel, Converter={StaticResource StringToVis}}">
                                                                                    <TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                                                                </Border>
                                                                                <Border Style="{StaticResource TagChip}" Margin="6,0,0,0">
                                                                                    <TextBlock Text="{Binding SizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                                                                </Border>
                                                                                <Border Style="{StaticResource TagChip}" Margin="6,0,0,0">
                                                                                    <TextBlock Text="{Binding FormatLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                                                                </Border>
                                                                            </WrapPanel>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                                                            <Button Style="{StaticResource IconGlyphButton}" Click="BtnRecordingPlay_Click" ToolTip="{DynamicResource Drawer_Recordings_Play}" Margin="0,0,0,6">
                                                                                <Path Data="M 8,5 L 8,19 L 19,12 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Button>
                                                                            <Button Style="{StaticResource IconGlyphButton}" Click="BtnRecordingDownload_Click" ToolTip="{DynamicResource Drawer_Recordings_Download}">
                                                                                <Path Data="M 12,2 L 12,16 M 6,10 L 12,16 L 18,10 M 4,20 L 20,20" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Button>
                                                                            <Button Style="{StaticResource IconGlyphButton}" Click="BtnRecordingUpload_Click" Loaded="BtnRecordingUpload_Loaded" ToolTip="{DynamicResource Drawer_Recordings_Upload}" Margin="0,6,0,0">
                                                                                <Path Data="M 12,22 L 12,8 M 6,14 L 12,8 L 18,14 M 4,22 L 20,22" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ListBox x:Name="ListRecordings" Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="6,8,6,0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrushCommon}" BorderThickness="1"
                                                    PreviewMouseRightButtonUp="RecordingItem_ContextMenu">
                                                <Grid Margin="10,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Border Style="{StaticResource TagChip}">
                                                                <TextBlock Text="{Binding StartTime, StringFormat=yyyy-MM-dd HH:mm}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                                            </Border>
                                                            <Border Style="{StaticResource TagChip}" Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding EndLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <WrapPanel Margin="0,4,0,0" ItemWidth="Auto" ItemHeight="Auto">
                                                            <Border Style="{StaticResource TagChip}" Visibility="{Binding SourceLabel, Converter={StaticResource StringToVis}}">
                                                                <TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                                            </Border>
                                                            <Border Style="{StaticResource TagChip}" Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding SizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                                            </Border>
                                                            <Border Style="{StaticResource TagChip}" Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding FormatLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                                            </Border>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <Button Style="{StaticResource IconGlyphButton}" Click="BtnRecordingPlay_Click" ToolTip="{DynamicResource Drawer_Recordings_Play}" Margin="0,0,0,6">
                                                            <Path Data="M 8,5 L 8,19 L 19,12 Z" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                                <Setter Property="Fill" Value="{DynamicResource StatusReplayBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Button>
                                                        <Button Style="{StaticResource IconGlyphButton}" Click="BtnRecordingDownload_Click" ToolTip="{DynamicResource Drawer_Recordings_Download}">
                                                            <Path Data="M 12,2 L 12,16 M 6,10 L 12,16 L 18,10 M 4,20 L 20,20" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{DynamicResource Tab_Favorites}">
                        <ListBox x:Name="ListFavorites" Background="Transparent" BorderThickness="0" Margin="10,10,10,0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="6,8,6,0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown">
                                        <Grid Margin="8,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding GlobalIndex}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                                            <Ellipse Grid.Column="2" Width="6" Height="6" Fill="#35C759" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Playing}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="R" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" 
                                                               VerticalAlignment="Top" Margin="4,2,0,0"
                                                               Visibility="{Binding HasCatchup, Converter={StaticResource BoolToVis}}" ToolTip="Catchup Available"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Group}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CurrentProgramTitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Visibility="{Binding CurrentProgramTitle, Converter={StaticResource StringToVis}}"/>
                                            </StackPanel>
                                            <Button Grid.Column="5" Style="{StaticResource BarButton}" Click="ToggleFavorite_Click" ToolTip="{DynamicResource Favorite_Toggle}">
                                                <TextBlock Text="{Binding Favorite, Converter={StaticResource BoolToStar}}" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Button>
                                            <Border Grid.Column="6" Width="80" Height="40" Background="{DynamicResource ChipButtonBackgroundBrush}" CornerRadius="8" HorizontalAlignment="Right">
                                                <Image helpers:ImageExtensions.RemoteUrl="{Binding Logo}" Stretch="Uniform" Width="80" Height="40"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- 底部控制栏 -->
        <Border x:Name="BottomBar" Grid.Row="2" Grid.Column="1" Background="{DynamicResource TopOverlayScrimBrush}" Height="64" BorderBrush="{DynamicResource BorderBrushCommon}" BorderThickness="0,1,0,0" PreviewMouseWheel="BottomBar_PreviewMouseWheel">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowStateActions.IsFullscreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMinimalMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 进度条 -->
                    <RowDefinition Height="*"/>    <!-- 按钮 -->
                </Grid.RowDefinitions>

                <!-- 进度条行 -->
                <Grid Grid.Row="0" Margin="0,0,0,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" x:Name="SliderSeek" Height="20" Style="{StaticResource UnifiedThickSlider}" 
                            Minimum="0" Maximum="{Binding SeekMaximum}" Value="{Binding SeekValue, Mode=TwoWay}"
                            PreviewMouseDown="SliderSeek_PreviewMouseDown"
                            PreviewMouseUp="SliderSeek_PreviewMouseUp"
                            PreviewMouseMove="SliderSeek_MouseMove"
                            MouseLeave="SliderSeek_MouseLeave"/>
                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnMute" Grid.Column="0" Style="{StaticResource BarButton}" ToolTip="{DynamicResource Overlay_Mute}" Click="BtnMute_Click" Margin="0,0,6,0">
                            <ui:SymbolIcon x:Name="IconMute" Symbol="Volume" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <controls:VolumeSlider Grid.Column="1" x:Name="SliderVolume"
                                               IsMuted="{Binding DataContext.IsMuted, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                               Volume="{Binding DataContext.Volume, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                               VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- 按钮行 -->
                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- 左 -->
                        <ColumnDefinition Width="*"/>    <!-- 中 -->
                        <ColumnDefinition Width="Auto"/> <!-- 右 -->
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：播放控制 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border x:Name="BottomStatusIndicator" Height="32" VerticalAlignment="Center" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="10,0" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtBottomPlaybackStatus" Text="{Binding PlaybackStatusText}" Foreground="{Binding PlaybackStatusBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Border>
                        <Button x:Name="BtnPlayPause" Style="{StaticResource BarButton}" Click="BtnPlayPause_Click">
                            <Viewbox Width="12" Height="12" Stretch="Uniform">
                                <Path x:Name="IconPlayPause" Fill="{DynamicResource TextPrimaryBrush}" Data="M4,2 L12,8 L4,14 Z"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="BtnStop" Style="{StaticResource BarButton}" Click="BtnStop_Click">
                            <Viewbox Width="12" Height="12" Stretch="Uniform">
                                <Path Fill="{DynamicResource TextPrimaryBrush}" Data="M3,3 H13 V13 H3 Z"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="BtnRew" Style="{StaticResource BarButton}" Click="BtnRew_Click">
                            <Viewbox Width="12" Height="12" Stretch="Uniform">
                                <Path Fill="{DynamicResource TextPrimaryBrush}" Data="M8,2 L2,8 L8,14 M12,2 V14"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="BtnFwd" Style="{StaticResource BarButton}" Click="BtnFwd_Click">
                            <Viewbox Width="12" Height="12" Stretch="Uniform">
                                <Path Fill="{DynamicResource TextPrimaryBrush}" Data="M4,2 L10,8 L4,14 M0,2 V14"/>
                            </Viewbox>
                        </Button>
                        
                        <!-- 时间信息 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock x:Name="LblElapsed" Text="{Binding ElapsedTimeText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text=" / " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock x:Name="LblDuration" Text="{Binding DurationText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <ItemsControl ItemsSource="{Binding MediaInfo.Tags}" VerticalAlignment="Center" Margin="12,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TagChip}" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- 右侧：工具 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- FCC/UDP removed from here -->
                        <ToggleButton x:Name="BtnSources" Style="{StaticResource BarToggle}" Click="BtnSources_Click" ToolTip="{DynamicResource Overlay_SwitchSource}">
                            <ContentControl x:Name="BtnSourcesIcon"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnRatio" Style="{StaticResource BarToggle}" Click="BtnRatio_Click" ToolTip="{DynamicResource Overlay_AspectRatio}">
                            <ContentControl x:Name="BtnRatioIcon"/>
                        </ToggleButton>
                        <!-- 倍速按钮（窗口模式） -->
                        <ToggleButton x:Name="BtnSpeed" Style="{StaticResource BarToggle}" Click="BtnSpeed_Click" ToolTip="{DynamicResource Overlay_Speed}" IsEnabled="{Binding IsSpeedEnabled}">
                            <TextBlock x:Name="LblSpeedWindow" Text="1.0x" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </ToggleButton>
                        <!-- 实时录播 -->
                        <ToggleButton x:Name="BtnRecordNow" Style="{StaticResource BarToggle}" Click="BtnRecordNow_Click" ToolTip="{DynamicResource Overlay_RecordNow}">
                            <Viewbox Width="12" Height="12" Stretch="Uniform">
                                <Path Fill="{DynamicResource TextPrimaryBrush}" Data="M12,2 C17.5,2 22,6.5 22,12 C22,17.5 17.5,22 12,22 C6.5,22 2,17.5 2,12 C2,6.5 6.5,2 12,2 M12,2 L12,12"/>
                            </Viewbox>
                        </ToggleButton>
                        <ToggleButton x:Name="CbTimeshift" Style="{StaticResource BarToggle}" IsChecked="{Binding IsTimeshiftActive, Mode=TwoWay}" ToolTip="{DynamicResource Overlay_Timeshift}">
                            <Viewbox Width="12" Height="12" Stretch="Uniform">
                                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" Data="M6,1 A5,5 0 1,1 6,11 A5,5 0 1,1 6,1 M6,3 V6.5 L8.5,8"/>
                            </Viewbox>
                        </ToggleButton>

                        <ToggleButton x:Name="CbEpg" Style="{StaticResource BarToggle}" Click="CbEpg_Click" ToolTip="{DynamicResource Overlay_EPG}">
                            <Viewbox Width="12" Height="12" Stretch="Uniform">
                                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" Data="M2,3 V13 H14 V3 Z M2,5 H14 M5,1 V3 M11,1 V3"/>
                            </Viewbox>
                        </ToggleButton>
                        <ToggleButton x:Name="CbDrawer" Style="{StaticResource BarToggle}" Click="CbDrawer_Click" ToolTip="{DynamicResource Overlay_ToggleDrawer}">
                            <Viewbox Width="12" Height="12" Stretch="Uniform">
                                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" Data="M2,4 H14 M2,8 H14 M2,12 H14 M5,4 V4.01 M5,8 V8.01 M5,12 V12.01"/>
                            </Viewbox>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
