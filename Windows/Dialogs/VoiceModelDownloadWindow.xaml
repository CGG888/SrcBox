<Window x:Class="LibmpvIptvClient.VoiceModelDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UI_WebRemote_VoiceModelDialog_Title}" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="TxtTitle" Grid.Row="0" FontSize="16" FontWeight="SemiBold"
               Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource UI_WebRemote_VoiceModelDialog_Title}"/>
    <TextBlock x:Name="TxtIntro" Grid.Row="1" Margin="0,6,0,12" TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondaryBrush}"/>

    <TextBlock x:Name="TxtStage" Grid.Row="2" Foreground="{DynamicResource TextPrimaryBrush}"/>
    <ProgressBar x:Name="PbProgress" Grid.Row="3" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100"/>
    <TextBlock x:Name="TxtDetail" Grid.Row="4" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
               Foreground="{DynamicResource TextSecondaryBrush}"/>
    <TextBlock x:Name="TxtRate" Grid.Row="5" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="BtnClose" Content="{DynamicResource Common_OK}" Width="96" Visibility="Collapsed"
              Click="BtnClose_Click" Style="{StaticResource AccentButtonStyle}"/>
      <Button x:Name="BtnCancel" Content="{DynamicResource Common_Cancel}" Width="96" Margin="8,0,0,0"
              Click="BtnCancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
