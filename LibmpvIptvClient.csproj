<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SrcBox</AssemblyName>
    <ApplicationIcon>srcbox.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>SrcBox</Product>
    <AssemblyTitle>SrcBox</AssemblyTitle>
    <Version>1.1.16</Version>
    <AssemblyVersion>1.1.16.0</AssemblyVersion>
    <FileVersion>1.1.16.0</FileVersion>
    <GenerateProgramFile>false</GenerateProgramFile>
    <DisableWinExeConsoleOutput>true</DisableWinExeConsoleOutput>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>LibmpvIptvClient.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.122" />
    <PackageReference Include="Fleck" Version="1.2.0" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="Downloader" Version="4.1.1" />
    <!-- Offline speech recognition for the web remote's push-to-talk: ONNX Runtime plus the Paraformer/
         SenseVoice front end. The model itself is downloaded on first use, not shipped. -->
    <PackageReference Include="ManySpeech.AliParaformerAsr" Version="1.1.9" />
  </ItemGroup>
  <ItemGroup>
    <!-- The test project copies source assets (dictionaries, overlay XAML) next to its own binaries;
         those copies live under Tests\ and must never be compiled into the app again. -->
    <Compile Remove="Tests\**\*.cs" />
    <None Include="Tests\**\*.cs" />
    <Page Remove="Tests\**" />
    <ApplicationDefinition Remove="Tests\**" />
    <Resource Remove="Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="libmpv-2.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="libmpv-2.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Resource Include="srcbox.png" />
    <Resource Include="srcbox.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- PWA icons served by the web remote (/icons/...), embedded so published builds work too -->
    <EmbeddedResource Include="docs\public\pwa\icon-192.png" LogicalName="SrcBox.Pwa.icon-192.png" />
    <EmbeddedResource Include="docs\public\pwa\icon-512.png" LogicalName="SrcBox.Pwa.icon-512.png" />
    <EmbeddedResource Include="docs\public\pwa\maskable-512.png" LogicalName="SrcBox.Pwa.maskable-512.png" />
    <EmbeddedResource Include="docs\public\pwa\apple-touch-icon-180.png" LogicalName="SrcBox.Pwa.apple-touch-icon-180.png" />
  </ItemGroup>
</Project>
